# Copy to .env and fill in real values. Never commit .env.
# The app refuses to start unless both of these are set.

# Username for the single local operator account.
APP_USER=changeme

# Password for that account. Use a long random value.
APP_PASSWORD=changeme-use-a-long-random-value

# Time zone all CSV timestamps are interpreted in (IANA zone id).
APP_TIME_ZONE=America/New_York
